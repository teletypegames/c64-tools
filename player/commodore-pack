#!/bin/sh
# commodore-pack <c64|plus4> <name> <version>
#
# Expects <name>-<version>.prg (and optionally metadata.json) in the working
# directory and produces, next to it:
#   <name>-<version>.html.zip            browser player (EmulatorJS + VICE core)
#   <name>-<version>-linux-x64.zip       yapeSDL + libSDL2 + launcher
#   <name>-<version>-win-x64.zip         yapeSDL.exe + SDL2.dll + launcher
#   <name>-<version>-mac-arm64.zip       yapeSDL.app (Apple Silicon) + launcher
#
# <name> is the pipeline's name and only names the archives. Inside them the
# launcher and the .prg carry the "name" from metadata.json, which is the name
# the catalog registers the software under and the store clients look for.
#
# The launchers rewrite yape.conf in the SDL pref folder before every start:
# EmulationLevel picks the machine, DisplayFrameRate = 0 hides the speed and
# frame counter yapeSDL otherwise draws in the top right corner.
set -eu

PLATFORM=${1:?platform}
NAME=${2:?name}
VERSION=${3:?version}
PLAYER_HOME=${PLAYER_HOME:-/opt/commodore-player}
PRG="$NAME-$VERSION.prg"
BASE="$NAME-$VERSION"

[ -f "$PRG" ] || { echo "commodore-pack: $PRG not found" >&2; exit 1; }

case "$PLATFORM" in
  c64)   CORE=c64;   CORE_ID=vice_x64sc;  LEVEL=2; MACHINE="Commodore 64" ;;
  plus4) CORE=plus4; CORE_ID=vice_xplus4; LEVEL=0; MACHINE="Commodore Plus/4" ;;
  *) echo "commodore-pack: unsupported platform '$PLATFORM'" >&2; exit 1 ;;
esac

TITLE=""
GAME=""
if [ -f metadata.json ]; then
  TITLE=$(sed -n 's/.*"title"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' metadata.json | head -n 1)
  GAME=$(sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' metadata.json | head -n 1)
fi
[ -n "$TITLE" ] || TITLE=$NAME
[ -n "$GAME" ] || GAME=$NAME
TITLE_HTML=$(printf '%s' "$TITLE" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
TITLE_SED=$(printf '%s' "$TITLE_HTML" | sed -e 's/[&|\\]/\\&/g')

readme() {
  cat <<TXT
$TITLE ($MACHINE) version $VERSION

Start the game with the launcher next to this file:
  $1

The launcher sets yapeSDL to $MACHINE mode, hides the frame counter and
autostarts $GAME.prg.

Controls (yapeSDL):
  joystick        arrow keys + left SHIFT, or a gamepad
  LALT + I        switch the emulated joystick port
  LALT + ENTER    toggle full screen
  LALT + 1..3     window size
  LALT + R        reset (SHIFT+F11 hard reset)
  LALT + S        show or hide the speed/frame counter
  ESC             emulator menu
  F12             quit

$2
See LICENSES.txt for the emulator licenses.
TXT
}

write_conf_sh() {
  cat <<'SH'
conf_dir=$1
conf="$conf_dir/yape.conf"
mkdir -p "$conf_dir"
if [ -f "$conf" ]; then
  grep -v -e '^EmulationLevel' -e '^DisplayFrameRate' "$conf" > "$conf.tmp" || true
  mv "$conf.tmp" "$conf"
else
  printf '[Yape configuration file]\n' > "$conf"
fi
printf 'DisplayFrameRate = 0\n' >> "$conf"
SH
  printf 'printf '"'"'EmulationLevel = %s\\n'"'"' >> "$conf"\n' "$LEVEL"
}

pack_dir() {
  rm -f "$1.zip"
  zip -qry "$1.zip" "$1"
  rm -rf "$1"
  echo "==> $1.zip"
}

# ---------------------------------------------------------------- web
WEB="$BASE-web"
rm -rf "$WEB"
mkdir -p "$WEB/data/cores/reports" "$WEB/data/compression"
for f in loader.js emulator.min.js emulator.min.css version.json; do
  cp "$PLAYER_HOME/emulatorjs/$f" "$WEB/data/$f"
done
cp "$PLAYER_HOME/emulatorjs/compression/extract7z.js" "$WEB/data/compression/"
cp "$PLAYER_HOME/emulatorjs/cores/$CORE_ID-wasm.data" \
   "$PLAYER_HOME/emulatorjs/cores/$CORE_ID-legacy-wasm.data" "$WEB/data/cores/"
cp "$PLAYER_HOME/emulatorjs/cores/reports/$CORE_ID.json" "$WEB/data/cores/reports/"
cp "$PRG" "$WEB/$GAME.prg"
cp "$PLAYER_HOME/LICENSES.txt" "$WEB/"
sed -e "s|@NAME@|$GAME|g" -e "s|@CORE@|$CORE|g" -e "s|@TITLE@|$TITLE_SED|g" \
    "$PLAYER_HOME/index.html" > "$WEB/index.html"
rm -f "$BASE.html.zip"
(cd "$WEB" && zip -qr "../$BASE.html.zip" .)
rm -rf "$WEB"
echo "==> $BASE.html.zip"

# ---------------------------------------------------------------- linux
DIR="$BASE-linux-x64"
rm -rf "$DIR"
mkdir -p "$DIR"
cp -r "$PLAYER_HOME/yapesdl/linux-x64/." "$DIR/"
cp "$PRG" "$DIR/$GAME.prg"
cp "$PLAYER_HOME/LICENSES.txt" "$DIR/"
{
  printf '#!/bin/sh\nset -e\ncd "$(dirname "$0")"\n'
  printf 'set_machine() {\n'
  write_conf_sh
  printf '}\n'
  printf 'set_machine "${XDG_DATA_HOME:-$HOME/.local/share}/Gaia/yapeSDL"\n'
  printf 'if ! ldconfig -p 2>/dev/null | grep -q "libSDL2-2\\.0\\.so\\.0"; then\n'
  printf '  export LD_LIBRARY_PATH="$PWD/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"\n'
  printf 'fi\n'
  printf 'exec ./yapesdl "$PWD/%s.prg"\n' "$GAME"
} > "$DIR/$GAME"
chmod 0755 "$DIR/$GAME" "$DIR/yapesdl"
readme "./$GAME" "The bundled libSDL2 is only used when the system has none." > "$DIR/README.txt"
pack_dir "$DIR"

# ---------------------------------------------------------------- windows
DIR="$BASE-win-x64"
rm -rf "$DIR"
mkdir -p "$DIR"
cp -r "$PLAYER_HOME/yapesdl/win-x64/." "$DIR/"
cp "$PRG" "$DIR/$GAME.prg"
cp "$PLAYER_HOME/LICENSES.txt" "$DIR/"
PS="\$d = Join-Path \$env:APPDATA 'Gaia\\yapeSDL'; New-Item -ItemType Directory -Force \$d | Out-Null; \$p = Join-Path \$d 'yape.conf'; \$lines = @('[Yape configuration file]'); if (Test-Path \$p) { \$lines = @(Get-Content \$p | Where-Object { \$_ -notmatch '^(EmulationLevel|DisplayFrameRate)' }) }; \$lines += 'EmulationLevel = $LEVEL'; \$lines += 'DisplayFrameRate = 0'; Set-Content -Path \$p -Value \$lines"
printf '@echo off\r\ncd /d "%%~dp0"\r\npowershell -NoProfile -ExecutionPolicy Bypass -Command "%s"\r\nstart "" "%%~dp0YapeSDL.exe" "%%~dp0%s.prg"\r\n' "$PS" "$GAME" > "$DIR/$GAME.bat"
readme "$GAME.bat" "" | sed 's/$/\r/' > "$DIR/README.txt"
pack_dir "$DIR"

# ---------------------------------------------------------------- mac
DIR="$BASE-mac-arm64"
rm -rf "$DIR"
mkdir -p "$DIR"
cp -R "$PLAYER_HOME/yapesdl/mac-arm64/." "$DIR/"
cp "$PRG" "$DIR/$GAME.prg"
cp "$PLAYER_HOME/LICENSES.txt" "$DIR/"
{
  printf '#!/bin/sh\nset -e\ncd "$(dirname "$0")"\n'
  printf 'set_machine() {\n'
  write_conf_sh
  printf '}\n'
  printf 'set_machine "$HOME/Library/Application Support/Gaia/yapeSDL"\n'
  printf 'exec ./yapeSDL.app/Contents/MacOS/yapeSDL "$PWD/%s.prg"\n' "$GAME"
} > "$DIR/$GAME.command"
chmod 0755 "$DIR/$GAME.command"
readme "$GAME.command (double-click, or run it from Terminal)" \
  "The app runs on Apple Silicon Macs only (arm64).
The app is not notarized: if macOS refuses to open it, right-click the launcher and choose Open, or run
  xattr -dr com.apple.quarantine .
in this folder once." > "$DIR/README.txt"
pack_dir "$DIR"

ls -lh "$BASE.html.zip" "$BASE-linux-x64.zip" "$BASE-win-x64.zip" "$BASE-mac-arm64.zip"
